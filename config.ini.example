; Файл конфигурации SQLBackup
; Разместите как config.ini рядом с исполняемым файлом

; [General] — общие настройки (используются как fallback для Backup-секций)
[General]
; Шаблон имени файла — {date} заменяется на текущую дату
NameTemplate = backup_{date}
; Формат даты (strftime-совместимый, по умолчанию: %d.%m.%Y)
DateFormat = %d.%m.%Y
; Расширение файлов для поиска (по умолчанию: .bak)
FileExtension = .bak
; Отладочный режим (true/false) — при true исходный файл НЕ удаляется
Debug = false
; Имя сервера для подстановки в тему/тело письма ({SERVERNAME})
; Если не указано — определяется автоматически (FQDN)
; ServerName = SRV-BACKUP-01
; Поведение при существующем файле назначения:
;   1 — перезаписать (по умолчанию)
;   2 — ошибка, прервать
;   3 — добавить суффикс _001, _002, ...
;   4 — пропустить, записав событие в лог
OnExists = 1

; Backup-секции: [Backup:<имя>]
; Каждая секция — отдельная задача копирования.
; SourcePath и DestPath обязательны; остальное наследуется из [General].
[Backup:DB1]
; Путь к папке с файлами резервных копий
SourcePath = C:\Backups\DB1
; Путь назначения (сетевой UNC или локальный путь)
DestPath = \\server1\share\DB1

[Backup:DB2]
SourcePath = C:\Backups\DB2
DestPath = \\server2\share\DB2
; Можно переопределить шаблон для конкретной секции
NameTemplate = archive_{date}
; Можно переопределить поведение при существующем файле для этой секции
; OnExists = 3

; Если Backup-секций нет — используются [General] SourcePath и DestPath
;[General]
;SourcePath = C:\Backups\SQL
;DestPath = \\server\share\Backups

[Mail]
; Адрес Exchange сервера (IP или имя хоста)
Server = exchange.company.local
; SMTP порт (обычно 25 или 587)
Port = 25
; Отображаемое имя отправителя
SenderName = SQL Backup Service
; Адрес электронной почты отправителя
SenderEmail = backup@company.local
; Получатели (email адреса через запятую)
Recipients = admin@company.local, dba@company.local
; Использовать аутентификацию SMTP (true/false)
Auth = false
; Имя пользователя SMTP (если Auth = true)
Username =
; Пароль SMTP (если Auth = true)
Password =
; Путь к файлу шаблона письма (HTML с переменными {LABEL}, {FILENAME},
; {FILESIZE}, {SOURCEPATH}, {DESTPATH}, {SOURCEURL}, {DESTURL}, {COPYDATE})
TemplatePath = mail_template.html
; Тема письма — поддерживает те же переменные, что и шаблон
; Subject = [{STATUSJOB}] Backup Copy [{LABEL}]: {FILENAME}

[Log]
; Путь к папке для файлов логов
LogPath = C:\Logs\SQLBackup
; Максимальное количество файлов логов (самые старые будут удалены)
MaxLogs = 30
